# Copy to backend/.env and fill in ONLY after obtaining the official API credentials.
# Do not commit backend/.env.
API_BASE_URL=
API_SERVICE_KEY=
API_KEY_PARAM=serviceKey
# Optional query parameters required by the official endpoint, JSON object string.
API_EXTRA_PARAMS={}
# Optional JSON mapping from normalized fields to provider response field names.
# Leave empty until the official response sample is inspected.
API_FIELD_MAP={}
